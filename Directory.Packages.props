<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build Tools -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Referenced by build-standards shared props for test projects; coverage is still collected with coverlet -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.4.1" />

    <!-- Source Generators -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />

    <!-- SynthDicom Dependencies -->
    <PackageVersion Include="fo-dicom" Version="5.2.6" />
    <PackageVersion Include="SynthEHR.Core" Version="3.0.1" />
    <!-- Used directly for the Csv output mode; previously only available transitively via HIC.SynthEHR -->
    <PackageVersion Include="CsvHelper" Version="33.0.1" />

    <!-- BadDicom Dependencies -->
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="DicomTypeTranslation" Version="5.0.1" />
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="16.3.0" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

    <!-- Transitive security pins -->
    <!-- FAnsiSql.Legacy (via DicomTypeTranslation) 3.7.0 brings patched drivers: MySqlConnector 2.6.2 (GHSA-473q-m89c-ghf8),
         System.Security.Cryptography.Pkcs 10.0.14 (GHSA-846f-f764-76mx), SQLitePCLRaw 3.0.5 (GHSA-2m69-gcr7-jv3q) -->
    <PackageVersion Include="FAnsiSql.Legacy" Version="3.7.0" />
  </ItemGroup>
</Project>
