<Project>
  <!-- Import shared build standards -->
  <Import Project="build-standards/Directory.Build.props.shared" />

  <!-- Repository-specific overrides -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Override MIT default - this repo is GPL-3.0 licensed -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Keep ImplicitUsings disabled (local override) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Keep GenerateAssemblyInfo disabled - using SharedAssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RollForward>Major</RollForward>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Shared assembly info -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)SharedAssemblyInfo.cs" Link="SharedAssemblyInfo.cs" />
  </ItemGroup>

  <!-- Additional package for GitHub source linking -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Test project package versions -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
